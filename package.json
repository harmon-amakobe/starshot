{
  "name": "starshot",
  "private": true,
  "version": "0.2.0",
  "description": "Starshot: a slingshot game across the real Solar System, plus the open orbital-mechanics packages behind it.",
  "homepage": "https://playstarshot.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/harmon-amakobe/starshot.git"
  },
  "bugs": {
    "url": "https://github.com/harmon-amakobe/starshot/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @starshot/game",
    "build": "npm run build -w @starshot/game",
    "preview": "npm run preview -w @starshot/game",
    "dev:prototype": "npm run dev -w @starshot/prototype",
    "build:prototype": "npm run build -w @starshot/prototype",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gates": "node scripts/gates.mjs",
    "gates:fast": "node scripts/gates.mjs --fast"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
